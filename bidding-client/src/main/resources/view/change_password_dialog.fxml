<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uet.client.ui.ChangePasswordDialogController"
      alignment="CENTER" spacing="15.0"
      stylesheets="@../style/change_password.css"
      styleClass="root"
      prefWidth="380.0">
    <padding>
        <Insets top="35.0" right="35.0" bottom="35.0" left="35.0"/>
    </padding>

    <Label text="Đổi mật khẩu" styleClass="title-label"/>

    <VBox spacing="8.0" prefWidth="300.0">
        <Label text="Mật khẩu cũ:" styleClass="field-label"/>
        <PasswordField fx:id="oldPasswordTxt" promptText="Nhập mật khẩu cũ" styleClass="custom-password-field"/>
    </VBox>

    <VBox spacing="8.0" prefWidth="300.0">
        <Label text="Mật khẩu mới:" styleClass="field-label"/>
        <PasswordField fx:id="newPasswordTxt" promptText="Nhập mật khẩu mới" styleClass="custom-password-field"/>
    </VBox>

    <VBox spacing="8.0" prefWidth="300.0">
        <Label text="Xác nhận mật khẩu mới:" styleClass="field-label"/>
        <PasswordField fx:id="confirmPasswordTxt" promptText="Nhập lại mật khẩu mới" styleClass="custom-password-field"/>
    </VBox>

    <HBox spacing="12.0" alignment="CENTER_RIGHT">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
        <Button text="Hủy" onAction="#handleCancel" styleClass="btn-cancel"/>
        <Button text="Lưu thay đổi" onAction="#handleSave" styleClass="btn-save"/>
    </HBox>

</VBox>
