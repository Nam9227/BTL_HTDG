<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650" prefWidth="1100" style="-fx-background-color: #2f3336;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.ui.admin.AdminAuctionsController">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="230" spacing="12" style="-fx-background-color: #24282b; -fx-padding: 25;">
            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="ADMIN PANEL" />
            <Separator />

            <Button maxWidth="Infinity" onAction="#goDashboard" text="Dashboard" />
            <Button maxWidth="Infinity" onAction="#goUsers" text="Quản lý người dùng" />
            <Button maxWidth="Infinity" onAction="#goProducts" text="Quản lý nạp rút " />

            <Button maxWidth="Infinity" style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;" text="Duyệt sản phẩm" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;" text="Đăng xuất" />
        </VBox>
    </left>

    <!-- Main -->
    <center>
        <VBox spacing="16" style="-fx-padding: 30; -fx-background-color: #F5F7FA;">

            <Label style="-fx-text-fill: #111827; -fx-font-size: 24px; -fx-font-weight: bold;" text="Danh sách sản phẩm chờ phê duyệt" />

            <TableView fx:id="approvalTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="80" text="Mã SP" />
                    <TableColumn fx:id="nameColumn" prefWidth="160" text="Tên sản phẩm" />
                    <TableColumn fx:id="sellerColumn" prefWidth="100" text="Người bán" />
                    <TableColumn fx:id="priceColumn" prefWidth="120" text="Giá hiện tại" />
                    <TableColumn fx:id="statusColumn" prefWidth="110" text="Trạng thái" />
                    <TableColumn fx:id="descriptionColumn" prefWidth="200" text="Mô tả" />
                    <TableColumn fx:id="actionColumn" prefWidth="180" text="Hành động" />
                </columns>
            </TableView>

            <Label fx:id="statusMessageLabel" style="-fx-font-size: 14px;" />
        </VBox>
    </center>
</BorderPane>
