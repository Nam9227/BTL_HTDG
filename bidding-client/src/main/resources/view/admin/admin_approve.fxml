<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<BorderPane prefHeight="650" prefWidth="1100" stylesheets="@../../style/admin_global.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.ui.admin.AdminAuctionsController">

    <!-- Sidebar -->
    <left>
        <VBox fx:id="adminPanel" prefWidth="240" spacing="12" styleClass="admin-sidebar">
            <Label fx:id="adminLabel" styleClass="admin-sidebar-title" text="ADMIN PANEL" />
            <Separator styleClass="admin-sidebar-separator" />

            <Button maxWidth="Infinity" onAction="#goDashboard" styleClass="sidebar-btn" text="📦 Dashboard" />
            <Button maxWidth="Infinity" onAction="#goUsers" styleClass="sidebar-btn" text="👥 Quản lý người dùng" />
            <Button maxWidth="Infinity" onAction="#goProducts" styleClass="sidebar-btn" text="💳 Quản lý nạp rút " />
            <Button maxWidth="Infinity" styleClass="sidebar-btn-active" text="⚖️ Duyệt phiên đấu giá" />

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="logOutButton" maxWidth="Infinity" onAction="#handleLogout" styleClass="sidebar-btn-logout" text="🚪 Đăng xuất" />
        </VBox>
    </left>

    <!-- Main -->
    <center>
        <VBox spacing="20" styleClass="main-content">
            <Label styleClass="page-title" text="Quản lý phiên đấu giá" />

            <HBox spacing="12" styleClass="filter-bar">
                <TextField fx:id="searchField" prefWidth="300" promptText="🔍 Tìm mã SP, tên SP, người bán..." styleClass="search-field" />
                <ComboBox fx:id="statusFilter" prefWidth="150" promptText="Trạng thái" styleClass="filter-combo" />
                <Button onAction="#handleRefresh" styleClass="action-btn-primary" text="🔄 Làm mới" />
            </HBox>

            <TableView fx:id="approvalTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="80" text="Mã SP" />
                    <TableColumn fx:id="nameColumn" prefWidth="160" text="Tên sản phẩm" />
                    <TableColumn fx:id="sellerColumn" prefWidth="100" text="Người bán" />
                    <TableColumn fx:id="priceColumn" prefWidth="120" text="Giá hiện tại" />
                    <TableColumn fx:id="statusColumn" prefWidth="110" text="Trạng thái" />
                    <TableColumn fx:id="descriptionColumn" prefWidth="200" text="Mô tả" />
                    <TableColumn fx:id="actionColumn" prefWidth="180" text="Hành động" />
                </columns>
            </TableView>

            <Label fx:id="statusMessageLabel" style="-fx-font-size: 14px;" />
        </VBox>
    </center>
</BorderPane>
