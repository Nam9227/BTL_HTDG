<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uet.client.ui.AdminDashboardController"
            prefWidth="1100" prefHeight="650"
            style="-fx-background-color: #2f3336;">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="230" spacing="12"
              style="-fx-background-color: #24282b; -fx-padding: 25;">
            <Label text="ADMIN PANEL"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Separator/>

            <Button text="Dashboard" onAction="#showDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Quản lý người dùng" onAction="#showUsers" maxWidth="Infinity"/>
            <Button text="Quản lý sản phẩm" onAction="#showProducts" maxWidth="Infinity"/>
            <Button text="Quản lý phiên đấu giá" onAction="#showAuctions" maxWidth="Infinity"/>
            <Button text="Duyệt sản phẩm" onAction="#showPendingProducts" maxWidth="Infinity"/>
            <Button text="Thống kê" onAction="#showReports" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Đăng xuất" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <VBox spacing="25" style="-fx-padding: 30;">
            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Dashboard"
                           style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                    <Label text="Tổng quan hệ thống đấu giá"
                           style="-fx-text-fill: #cfcfcf; -fx-font-size: 14px;"/>
                </VBox>
            </HBox>

            <!-- Statistic cards -->
            <HBox spacing="20">
                <VBox prefWidth="190" spacing="8"
                      style="-fx-background-color: #3a3f42; -fx-background-radius: 16; -fx-padding: 20;">
                    <Label text="Người dùng"
                           style="-fx-text-fill: #cfcfcf; -fx-font-size: 14px;"/>
                    <Label fx:id="totalUsersLabel" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox prefWidth="190" spacing="8"
                      style="-fx-background-color: #3a3f42; -fx-background-radius: 16; -fx-padding: 20;">
                    <Label text="Sản phẩm"
                           style="-fx-text-fill: #cfcfcf; -fx-font-size: 14px;"/>
                    <Label fx:id="totalProductsLabel" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox prefWidth="190" spacing="8"
                      style="-fx-background-color: #3a3f42; -fx-background-radius: 16; -fx-padding: 20;">
                    <Label text="Đang đấu giá"
                           style="-fx-text-fill: #cfcfcf; -fx-font-size: 14px;"/>
                    <Label fx:id="activeAuctionsLabel" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox prefWidth="190" spacing="8"
                      style="-fx-background-color: #3a3f42; -fx-background-radius: 16; -fx-padding: 20;">
                    <Label text="Chờ duyệt"
                           style="-fx-text-fill: #cfcfcf; -fx-font-size: 14px;"/>
                    <Label fx:id="pendingProductsLabel" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <!-- Recent management table -->
            <VBox spacing="12"
                  style="-fx-background-color: #3a3f42; -fx-background-radius: 16; -fx-padding: 20;">
                <Label text="Hoạt động gần đây"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                <TableView fx:id="recentActivityTable" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="timeColumn" text="Thời gian" prefWidth="160"/>
                        <TableColumn fx:id="actionColumn" text="Hành động" prefWidth="260"/>
                        <TableColumn fx:id="targetColumn" text="Đối tượng" prefWidth="220"/>
                        <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>