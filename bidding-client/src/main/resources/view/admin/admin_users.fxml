<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uet.client.ui.admin.AdminUsersController"
            prefWidth="1100" prefHeight="650"
            style="-fx-background-color: #2f3336;">

    <left>
        <VBox prefWidth="230" spacing="12"
              style="-fx-background-color: #24282b; -fx-padding: 25;">
            <Label text="ADMIN PANEL"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Separator/>

            <Button text="Dashboard" onAction="#goDashboard" maxWidth="Infinity"/>
            <Button text="Quản lý người dùng" maxWidth="Infinity"
                    style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Quản lý sản phẩm" onAction="#goProducts" maxWidth="Infinity"/>
            <Button text="Duyệt sản phẩm" onAction="#goPendingProducts" maxWidth="Infinity"/>


            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Đăng xuất" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label text="Quản lý người dùng"
                   style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>

            <HBox spacing="12">
                <TextField fx:id="searchField"
                           promptText="Tìm theo username, email, họ tên..."
                           prefWidth="420"/>

                <ComboBox fx:id="roleFilter"
                          promptText="Vai trò"
                          prefWidth="140"/>

                <ComboBox fx:id="statusFilter"
                          promptText="Trạng thái"
                          prefWidth="150"/>

                <Button text="Tìm kiếm"
                        onAction="#handleSearch"
                        style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Làm mới"
                        onAction="#handleRefresh"/>
            </HBox>

            <TableView fx:id="userTable" prefHeight="440">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="150"/>
                    <TableColumn fx:id="fullNameColumn" text="Họ tên" prefWidth="170"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                    <TableColumn fx:id="phoneColumn" text="SĐT" prefWidth="130"/>
                    <TableColumn fx:id="roleColumn" text="Vai trò" prefWidth="100"/>
                    <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Xem chi tiết"
                        onAction="#handleViewDetail"/>

                <Button text="Khóa tài khoản"
                        onAction="#handleLockUser"
                        style="-fx-background-color: #d9822b; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Mở khóa"
                        onAction="#handleUnlockUser"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Xóa"
                        onAction="#handleDeleteUser"
                        style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>