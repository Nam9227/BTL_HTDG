<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650" prefWidth="1100" stylesheets="@../../style/admin_global.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.ui.admin.AdminUsersController">

    <!-- Sidebar -->
    <left>
        <VBox fx:id="adminPanel" prefWidth="240" spacing="12" styleClass="admin-sidebar">
            <Label fx:id="adminLabel" styleClass="admin-sidebar-title" text="ADMIN PANEL" />
            <Separator styleClass="admin-sidebar-separator" />

            <Button maxWidth="Infinity" onAction="#goDashboard" styleClass="sidebar-btn" text="📦 Dashboard" />
            <Button maxWidth="Infinity" styleClass="sidebar-btn-active" text="👥 Quản lý người dùng" />
            <Button maxWidth="Infinity" onAction="#goProducts" styleClass="sidebar-btn" text="💳 Quản lý nạp rút " />
            <Button maxWidth="Infinity" onAction="#goApprove" styleClass="sidebar-btn" text="⚖️ Duyệt phiên đấu giá" />

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="logOutButton" maxWidth="Infinity" onAction="#handleLogout" styleClass="sidebar-btn-logout" text="🚪 Đăng xuất" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label styleClass="title-header" text="Quản lý người dùng" />

            <HBox spacing="12">
                <TextField fx:id="searchField" prefWidth="420" promptText="Tìm theo username, email, họ tên..." styleClass="text-field" />

                <ComboBox fx:id="roleFilter" prefWidth="140" promptText="Vai trò" styleClass="combo-box" />

                <ComboBox fx:id="statusFilter" prefWidth="150" promptText="Trạng thái" styleClass="combo-box" />

                <Button onAction="#handleSearch" styleClass="btn-primary" text="Tìm kiếm" />

                <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Làm mới" />
            </HBox>

            <TableView fx:id="userTable" prefHeight="440" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                    <TableColumn fx:id="usernameColumn" prefWidth="150" text="Username" />
                    <TableColumn fx:id="fullNameColumn" prefWidth="170" text="Họ tên" />
                    <TableColumn fx:id="emailColumn" prefWidth="220" text="Email" />
                    <TableColumn fx:id="phoneColumn" prefWidth="130" text="SĐT" />
                    <TableColumn fx:id="roleColumn" prefWidth="100" text="Vai trò" />
                    <TableColumn fx:id="statusColumn" prefWidth="120" text="Trạng thái" />
                    <TableColumn fx:id="lastLoginColumn" prefWidth="150" text="Đăng nhập gần nhất" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button onAction="#handleViewDetail" styleClass="btn-secondary" text="Xem chi tiết" />

                <Button onAction="#handleLockUser" styleClass="btn-warning" text="Khóa tài khoản" />

                <Button onAction="#handleUnlockUser" styleClass="btn-success" text="Mở khóa" />

                <Button onAction="#handleDeleteUser" styleClass="btn-danger" text="Xóa" />
            </HBox>
        </VBox>
    </center>
</BorderPane>