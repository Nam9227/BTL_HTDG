<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650" prefWidth="1100" style="-fx-background-color: #2f3336;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.ui.admin.AdminUsersController">

    <left>
        <VBox prefWidth="230" spacing="12" style="-fx-background-color: #24282b; -fx-padding: 25;">
            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="ADMIN PANEL" />
            <Separator />

            <Button maxWidth="Infinity" onAction="#goDashboard" text="Dashboard" />
            <Button maxWidth="Infinity" style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;" text="Quản lý người dùng" />
            <Button maxWidth="Infinity" onAction="#goProducts" text="Quản lý nạp rút" />
            <Button maxWidth="Infinity" onAction="#goPendingProducts" text="Duyệt sản phẩm" />


            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;" text="Đăng xuất" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;" text="Quản lý người dùng" />

            <HBox spacing="12">
                <TextField fx:id="searchField" prefWidth="420" promptText="Tìm theo username, email, họ tên..." />

                <ComboBox fx:id="roleFilter" prefWidth="140" promptText="Vai trò" />

                <ComboBox fx:id="statusFilter" prefWidth="150" promptText="Trạng thái" />

                <Button onAction="#handleSearch" style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;" text="Tìm kiếm" />

                <Button onAction="#handleRefresh" text="Làm mới" />
            </HBox>

            <TableView fx:id="userTable" prefHeight="440">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
                    <TableColumn fx:id="usernameColumn" prefWidth="150" text="Username" />
                    <TableColumn fx:id="fullNameColumn" prefWidth="170" text="Họ tên" />
                    <TableColumn fx:id="emailColumn" prefWidth="220" text="Email" />
                    <TableColumn fx:id="phoneColumn" prefWidth="130" text="SĐT" />
                    <TableColumn fx:id="roleColumn" prefWidth="100" text="Vai trò" />
                    <TableColumn fx:id="statusColumn" prefWidth="120" text="Trạng thái" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button onAction="#handleViewDetail" text="Xem chi tiết" />

                <Button onAction="#handleLockUser" style="-fx-background-color: #d9822b; -fx-text-fill: white; -fx-font-weight: bold;" text="Khóa tài khoản" />

                <Button onAction="#handleUnlockUser" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" text="Mở khóa" />

                <Button onAction="#handleDeleteUser" style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;" text="Xóa" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
