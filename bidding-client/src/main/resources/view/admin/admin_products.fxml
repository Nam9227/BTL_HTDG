<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.uet.client.ui.admin.AdminProductsController"
            prefWidth="1100" prefHeight="650"
            style="-fx-background-color: #2f3336;">

    <left>
        <VBox prefWidth="230" spacing="12"
              style="-fx-background-color: #24282b; -fx-padding: 25;">
            <Label text="ADMIN PANEL"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Separator/>

            <Button text="Dashboard" onAction="#goDashboard" maxWidth="Infinity"/>
            <Button text="Quản lý người dùng" onAction="#goUsers" maxWidth="Infinity"/>

            <Button text="Quản lý sản phẩm" maxWidth="Infinity"
                    style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <Button text="Quản lý phiên đấu giá" onAction="#goAuctions" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Đăng xuất" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label text="Quản lý sản phẩm"
                   style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>

            <HBox spacing="12">
                <TextField fx:id="searchField"
                           promptText="Tìm theo tên sản phẩm, người đăng..."
                           prefWidth="380"/>

                <ComboBox fx:id="statusFilter"
                          promptText="Trạng thái"
                          prefWidth="160"/>

                <Button text="Tìm kiếm"
                        onAction="#handleSearch"
                        style="-fx-background-color: #4f9db2; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Làm mới"
                        onAction="#handleRefresh"/>
            </HBox>

            <TableView fx:id="productTable" prefHeight="430">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="nameColumn" text="Tên sản phẩm" prefWidth="210"/>
                    <TableColumn fx:id="ownerColumn" text="Người đăng" prefWidth="140"/>
                    <TableColumn fx:id="startPriceColumn" text="Giá khởi điểm" prefWidth="130"/>
                    <TableColumn fx:id="currentPriceColumn" text="Giá hiện tại" prefWidth="130"/>
                    <TableColumn fx:id="createdAtColumn" text="Ngày đăng" prefWidth="150"/>
                    <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Xem chi tiết"
                        onAction="#handleViewDetail"/>

                <Button text="Duyệt"
                        onAction="#handleApprove"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Từ chối"
                        onAction="#handleReject"
                        style="-fx-background-color: #d9822b; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button text="Xóa"
                        onAction="#handleDelete"
                        style="-fx-background-color: #b23b3b; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>