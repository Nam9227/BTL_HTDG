<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="750" prefWidth="1050" style="-fx-background-color: #2a2e31;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.ui.ProfileController">

    <VBox spacing="30" alignment="TOP_CENTER" AnchorPane.leftAnchor="80" AnchorPane.rightAnchor="80" AnchorPane.topAnchor="50" AnchorPane.bottomAnchor="50">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <Button onAction="#handleBack" text="← Quay lại trang chủ" style="-fx-background-color: #3f454a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14; -fx-padding: 10 20; -fx-cursor: hand;"/>
            <Label style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;" text="Hồ sơ cá nhân" />
        </HBox>

        <HBox spacing="40" alignment="CENTER_LEFT" style="-fx-background-color: #3f454a; -fx-background-radius: 22; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 8);">

            <Button fx:id="avatarChangeBtn" mnemonicParsing="false" onAction="#handleAvatarChange" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <StackPane prefHeight="100" prefWidth="100">
                        <Circle fill="#55a8be" radius="45" />
                        <ImageView fx:id="avatarImage" fitHeight="70" fitWidth="70" preserveRatio="true" />
                    </StackPane>
                </graphic>
            </Button>

            <VBox alignment="CENTER_LEFT" spacing="8" prefWidth="300">
                <Label fx:id="fullNameLabel" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" text="Nguyễn Văn A" />
                <Label fx:id="usernameLabel" style="-fx-text-fill: #ccc; -fx-font-size: 16px;" text="@admin1" />
                <Label fx:id="statusLabel" style="-fx-text-fill: #98f5a1; -fx-font-size: 14px;" text="• Đang hoạt động" />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="25" HBox.hgrow="ALWAYS" style="-fx-background-color: #2a2e31; -fx-padding: 20 30; -fx-background-radius: 16;">
                <VBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Số dư hiện có" style="-fx-text-fill: #bbb; -fx-font-size: 14px;"/>
                    <Label fx:id="balanceLabel" text="5,000,000 đ" style="-fx-text-fill: #98f5a1; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="12">
                    <Button onAction="#handleDeposit" text="Nạp thêm tiền" prefWidth="120" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 0; -fx-cursor: hand;"/>
                    <Button onAction="#handleWithdraw" text="Rút tiền mặt" prefWidth="120" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 8 0; -fx-cursor: hand;"/>
                </VBox>
            </HBox>
        </HBox>

        <GridPane hgap="30" vgap="22" style="-fx-background-color: #3f454a; -fx-background-radius: 22; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 8);">
            <columnConstraints>
                <ColumnConstraints percentWidth="18" />
                <ColumnConstraints percentWidth="32" />
                <ColumnConstraints percentWidth="18" />
                <ColumnConstraints percentWidth="32" />
            </columnConstraints>

            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 500;" text="Họ và tên:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="fullNameField" editable="false" promptText="Nhập họ tên" style="-fx-background-color: #2a2e31; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 500;" text="Tên đăng nhập:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="usernameField" editable="false" style="-fx-background-color: #2a2e31; -fx-text-fill: #999; -fx-background-radius: 8; -fx-padding: 10;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 500;" text="Thư điện tử (Email):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="emailField" editable="false" promptText="example@gmail.com" style="-fx-background-color: #2a2e31; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 500;" text="Số điện thoại:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="phoneField" editable="false" promptText="0123456789" style="-fx-background-color: #2a2e31; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 500;" text="Địa chỉ liên hệ:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="addressField" editable="false" promptText="Nhập địa chỉ" style="-fx-background-color: #2a2e31; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="editButton" onAction="#handleEdit" style="-fx-background-color: #55a8be; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 25; -fx-padding: 12 35; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 3);" text="Chỉnh sửa thông tin" />
            <Button fx:id="saveButton" disable="true" onAction="#handleSave" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 25; -fx-padding: 12 35; -fx-cursor: hand;" text="Lưu thay đổi" />
            <Button fx:id="changePasswordButton" onAction="#handleChangePassword" style="-fx-background-color: #61686d; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 25; -fx-padding: 12 35; -fx-cursor: hand;" text="Đổi mật khẩu bảo mật" />
        </HBox>

    </VBox>
</AnchorPane>